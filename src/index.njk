      <a href="https://in.pinterest.com/sxryadipta/" rel="me noopener" target="_blank">Pinterest</a>
      <a href="https://www.instagram.com/sxryadipta/" rel="me noopener" target="_blank">Instagram</a>
      <a href="{{ person.twitterUrl }}" rel="me noopener" target="_blank">X</a>
