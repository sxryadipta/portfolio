---
import BaseLayout from '../layouts/BaseLayout.astro';
import { identity, socials, codingProfiles } from '../data/identity.js';
---

<BaseLayout>
  <main class="container">
    <section id="about">
      <h1>{identity.name}</h1>
      <p class="handle">@{identity.handle}</p>
      <p class="tagline">{identity.tagline}</p>

      <div class="socials">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="me noopener">{s.label}</a>
        ))}
      </div>

      <div class="coding-profiles">
        {codingProfiles.map((c) => (
          <a href={c.url} target="_blank" rel="noopener">{c.label}</a>
        ))}
      </div>
    </section>

    <!-- Phase 2 will add: #projects, #experience, #blog, #pinterest -->
  </main>
</BaseLayout>