{% set pageTitle = title or site.defaultTitle %}
{% set pageDescription = description or site.defaultDescription %}
{% set pageUrl = site.baseUrl + (canonical or page.url) %}
{% set pageImage = ogImage or site.defaultOgImage %}
{% set pageImageUrl = site.baseUrl + pageImage %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ pageUrl }}">

<!-- Explicitly allow large image previews — directly affects Google Images eligibility -->
<meta name="robots" content="index, follow, max-image-preview:large">

<!-- Open Graph -->
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.siteName }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImageUrl }}">
<meta property="og:image:width" content="{{ ogImageWidth or 1200 }}">
<meta property="og:image:height" content="{{ ogImageHeight or 630 }}">
{% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}
<meta property="og:locale" content="{{ site.locale }}">

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.twitterHandle }}">
<meta name="twitter:creator" content="{{ person.twitterCreator }}">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImageUrl }}">
{% if ogImageAlt %}<meta name="twitter:image:alt" content="{{ ogImageAlt }}">{% endif %}

<!-- JSON-LD: Person — identical on every page, this consistency is what ties
     "Suryadipta Ghosh" and "sxryadipta" into one entity in Google's Knowledge Graph -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ person.name | dump | safe }},
  "alternateName": {{ person.alternateName | dump | safe }},
  "jobTitle": {{ person.jobTitle | dump | safe }},
  "description": {{ person.description | dump | safe }},
  "url": {{ person.url | dump | safe }},
  "image": {{ person.image | dump | safe }},
  "sameAs": {{ person.sameAs | dump | safe }}
}
</script>

{% if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.siteName | dump | safe }},
  "url": {{ site.baseUrl | dump | safe }},
  "author": {
    "@type": "Person",
    "name": {{ person.name | dump | safe }},
    "alternateName": {{ person.alternateName | dump | safe }}
  }
}
</script>
{% endif %}

{% if jsonLdImage %}
<!-- JSON-LD: ImageObject — this is the single biggest lever for Google Images
     indexing. It ties the specific photo to the Person entity as creator. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "name": {{ jsonLdImage.title | dump | safe }},
  "description": {{ jsonLdImage.caption | dump | safe }},
  "contentUrl": {{ jsonLdImage.contentUrl | dump | safe }},
  "thumbnailUrl": {{ jsonLdImage.thumbnailUrl | dump | safe }},
  "width": {{ jsonLdImage.width }},
  "height": {{ jsonLdImage.height }},
  "uploadDate": {{ jsonLdImage.dateTaken | dump | safe }},
  "representativeOfPage": true,
  "creator": {
    "@type": "Person",
    "name": {{ person.name | dump | safe }},
    "alternateName": {{ person.alternateName | dump | safe }}
  }{% if jsonLdImage.location %},
  "contentLocation": {
    "@type": "Place",
    "name": {{ jsonLdImage.location | dump | safe }}
  }{% endif %}
}
</script>
{% endif %}